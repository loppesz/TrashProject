# Materiais de aula / anotacoes (nao fazem parte do codigo da aplicacao)
Slides/
scratch_slides.txt

# Dependencias e build
/vendor/
/node_modules/

# Ambiente e credenciais
.env
*.local
# Credenciais locais (senha do banco) – cada dev tem a sua
app/config/config.local.php

# Logs e cache
*.log
/tmp/

# Arquivos de SO / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Uploads de usuarios (fotos de ocorrencias) - nao versionar os arquivos
/assets/uploads/**
!/assets/uploads/.gitkeep

# Backups do banco gerados antes das migrations (podem conter dados pessoais)
/modelo/_backup_*.json

# Scripts temporarios de diagnostico
/_*.php
/_*.txt

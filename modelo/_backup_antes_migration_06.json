    "coleta_create": "CREATE TABLE `coleta` (\n  `id_coleta` int unsigned NOT NULL AUTO_INCREMENT,\n  `id_bairro` int unsigned NOT NULL,\n  `dia_semana` tinyint unsigned NOT NULL,\n  `horario_inicio` time NOT NULL,\n  `horario_fim` time NOT NULL,\n  `equipe_responsavel` varchar(150) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `telefone_contato` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `observacao` varchar(500) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `ativo` tinyint(1) NOT NULL DEFAULT '1',\n  PRIMARY KEY (`id_coleta`),\n  UNIQUE KEY `uk_coleta_bairro_dia_hora` (`id_bairro`,`dia_semana`,`horario_inicio`),\n  KEY `idx_coleta_consulta` (`id_bairro`,`ativo`,`dia_semana`),\n  CONSTRAINT `coleta_ibfk_1` FOREIGN KEY (`id_bairro`) REFERENCES `bairro` (`id_bairro`),\n  CONSTRAINT `ck_coleta_dia` CHECK ((`dia_semana` between 1 and 7)),\n  CONSTRAINT `ck_coleta_horario` CHECK ((`horario_fim` > `horario_inicio`))\n) ENGINE=InnoDB AUTO_INCREMENT=15 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
